# このファイルをコピーして .env を作り、実際の値を書き込んでください。
# .env はGitには絶対にコミットしないこと（.gitignoreで除外済み）。

# Instagramの長期アクセストークン（Meta Graph API Explorer等で取得）
IG_ACCESS_TOKEN=

# InstagramビジネスアカウントID
IG_BUSINESS_ACCOUNT_ID=

# 動画を公開URLとして読み込むためのベースURL
# 例: https://raw.githubusercontent.com/<ユーザー名>/komugi-instagram/main
GITHUB_RAW_BASE=
